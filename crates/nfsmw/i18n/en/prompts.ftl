### prompts

## The footer's hints (frontend/prompts.rs) the game has no word for; the others are the game's own hint labels.

# The controls list: Left and Right move between a row's two keys.
prompts-column = Column
# The controls list: Accept takes the next key pressed for the selected slot.
prompts-remap = Remap
# The EA Trax jukebox: Accept changes where the selected song plays.
prompts-change-mode = Change mode
# The Blacklist: Accept opens the selected rival's bio.
prompts-view-rival = View Rival
# The option lists: Left and Right change the selected setting.
prompts-adjust = Adjust

## The full-screen world map's footer (frontend/world_map/control.rs).

# The key that shows or hides the map's legend.
prompts-legend = Legend
