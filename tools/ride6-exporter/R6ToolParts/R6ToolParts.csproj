<Project Sdk="Microsoft.NET.Sdk">
  <!-- Our own console tool around CUE4Parse (Apache-2.0, FabianFG). CUE4Parse is cloned OUTSIDE the repository;
       point CUE4PARSE_DIR at the clone (default C:\r6work\tools\CUE4Parse). See ../README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>R6ToolParts</AssemblyName>
    <RootNamespace>R6ToolParts</RootNamespace>
    <CUE4PARSE_DIR Condition="'$(CUE4PARSE_DIR)' == ''">C:\r6work\tools\CUE4Parse</CUE4PARSE_DIR>
    <CUE4PARSE_SKIP_NATIVE>true</CUE4PARSE_SKIP_NATIVE>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CUE4PARSE_DIR)\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="$(CUE4PARSE_DIR)\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>
</Project>
