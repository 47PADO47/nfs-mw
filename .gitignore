# WHITELIST. Everything is ignored unless re-included below, so game data,
# dumps, build output and local config can never be committed by accident.
# Adding a new kind of file? Add a narrow pattern here on purpose.
# (`cargo xtask leak-check` and CI double-check what is tracked.)

*
!*/

# Repository metadata and tooling config
!/.gitignore
!/.gitattributes
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/*.md
!/.github/PULL_REQUEST_TEMPLATE.md
!/.githooks/pre-commit
!/.cargo/config.toml
!/rust-toolchain.toml
!/.env.example
!/deny.toml
!/rustfmt.toml

# Legal and top-level docs
!/LICENSE-MIT
!/LICENSE-APACHE
!/NOTICE
!/README.md
!/CONTRIBUTING.md
!/AGENTS.md

# Rust workspace: engine-generic libraries (libs/) and the game (crates/)
!/Cargo.toml
!/Cargo.lock
!/libs/*/Cargo.toml
!/libs/*/README.md
# Per-crate licence texts for ported third-party code (e.g. libs/blackbox-smaa/LICENSE-SMAA).
!/libs/*/LICENSE-*
!/libs/*/src/**/*.rs
!/libs/blackbox-render/build.rs
!/libs/blackbox-render/src/gpu/dlss/bridge.cpp
!/libs/blackbox-render/src/gpu/dlss/presentation.cpp
!/libs/blackbox-render/src/gpu/dlss/dx12.cpp
!/libs/*/src/**/*.wgsl
!/libs/*/src/**/*.wesl
!/libs/*/tests/**/*.rs
!/libs/blackbox-vehicle/examples/physics_reference/**/*.rs
!/libs/blackbox-net-core/examples/*.rs
# cargo-fuzz targets (their own workspace; their Cargo.lock, corpus and artifacts stay local)
!/libs/blackbox-net-core/fuzz/Cargo.toml
!/libs/blackbox-net-core/fuzz/fuzz_targets/*.rs
!/crates/*/Cargo.toml
!/crates/*/src/**/*.rs
!/crates/*/src/**/*.wgsl
!/crates/*/tests/**/*.rs
!/crates/nfsmw-data/examples/physics_profiles.rs
# The dedicated server's sample config (docs/specs/multiplayer/server.md).
!/crates/nfsmw-server/server.toml
# The game binary's link settings (its main thread's stack).
!/crates/nfsmw/build.rs
# The rewrite's own translation catalogue (docs/decisions/0012-localization.md). Never game text.
!/crates/nfsmw/i18n/*/*.ftl
!/xtask/Cargo.toml
!/xtask/src/**/*.rs

# Example mods (ADR 0005 section 8): manifests and sources only; a built library is never committed
!/examples/**/Cargo.toml
!/examples/**/*.rs
!/examples/**/mod.toml
!/examples/mods/*/lang/**/*.ftl

# Documentation (Markdown only)
!/docs/**/*.md

# Python research tools and their tests
!/tools/**/*.py
!/tests/*.py

# Reviewed, independently licensed controller prompts (no game textures).
!/assets/input-prompts/kenney-xbox.png
!/assets/input-prompts/*.md

# Reviewed original icons for the mod manager (no game textures).
!/assets/mods/*.png
!/assets/mods/*.md

# Reviewed, independently licensed Discord mark (CC0 Simple Icons glyph).
!/assets/discord/discord.png
!/assets/discord/*.md

# Never, even if a pattern above matches.
/target/
.env
.claude/
__pycache__/
